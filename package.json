{
  "name": "group-home-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:bundle && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pdf:sample": "tsx --tsconfig scripts/tsconfig.json scripts/render-sample-pdf.tsx",
    "verify:guardrails": "tsx --tsconfig scripts/tsconfig.json scripts/verify-guardrails.ts",
    "verify:ai": "tsx --tsconfig scripts/tsconfig.json scripts/verify-ai-grounding.ts",
    "verify:branding": "tsx --tsconfig scripts/tsconfig.json scripts/verify-branding.tsx",
    "verify:timezone": "tsx --tsconfig scripts/tsconfig.json scripts/verify-timezone.ts",
    "verify:roster-privacy": "tsx --tsconfig scripts/tsconfig.json scripts/verify-roster-privacy.ts",
    "verify:records": "tsx --tsconfig scripts/tsconfig.json scripts/verify-records.tsx",
    "verify:schema": "tsx --tsconfig scripts/tsconfig.json scripts/verify-schema.ts",
    "bootstrap:admin": "tsx --tsconfig scripts/tsconfig.json scripts/bootstrap-admin.ts",
    "db:bundle": "tsx --tsconfig scripts/tsconfig.json scripts/bundle-migrations.ts",
    "db:verify": "tsx --tsconfig scripts/tsconfig.json scripts/verify-db.ts",
    "brand:scan": "tsx --tsconfig scripts/tsconfig.json scripts/scan-brand.ts",
    "db:seed": "tsx --tsconfig scripts/tsconfig.json scripts/seed-supabase.ts",
    "apk": "bash scripts/build-apk.sh",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:local-ai": "AI_PROVIDER=local OLLAMA_MODEL=qwen3.5:9b next dev -H 0.0.0.0",
    "dev:local-ai-fast": "AI_PROVIDER=local OLLAMA_MODEL=qwen2.5:7b next dev -H 0.0.0.0",
    "staff:add": "tsx --tsconfig scripts/tsconfig.json scripts/create-staff.ts",
    "compare:models": "tsx --tsconfig scripts/tsconfig.json scripts/compare-models.ts",
    "verify:import": "tsx --tsconfig scripts/tsconfig.json scripts/verify-import.ts",
    "demo:prune": "tsx --tsconfig scripts/tsconfig.json scripts/prune-demos.ts",
    "billing:set-price": "tsx --tsconfig scripts/tsconfig.json scripts/set-org-price.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@electric-sql/pglite": "^0.5.4",
    "@react-pdf/renderer": "^4.1.6",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.57.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "15.5.12",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
