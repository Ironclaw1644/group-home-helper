# ---------------------------------------------------------------------------
# Note assistant
#
# Default is a LOCAL model via Ollama: nothing leaves this machine, there is no
# account to create, no API key, and no per-note cost. That also means no BAA
# is needed with any AI vendor, because no PHI is ever transmitted.
# ---------------------------------------------------------------------------

# local | anthropic
#   local     — Ollama on the same machine. Free, nothing leaves the box, but
#               only reachable from that machine's network.
#   anthropic — hosted model. Works from anywhere; needs a key, costs a fraction
#               of a cent per note, and note content leaves your infrastructure.
#   openai    — same trade as anthropic, different vendor. Also covers Azure
#               OpenAI and any OpenAI-compatible gateway via OPENAI_BASE_URL.
#
# All three produce the same note through the same guards, so switching is this
# one line. Run `npm run compare:models` to price and grade them side by side.
AI_PROVIDER=anthropic

# --- local provider (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Keep the model resident between notes so only the first note pays load time.
OLLAMA_KEEP_ALIVE=30m
# Leave false. With reasoning enabled the same model took over seven minutes
# per note in testing, versus about twelve seconds with it off.
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=180000

# --- hosted providers (optional) ---
# Sending note content to a third party requires signed BAAs with the vendor and
# your host — see README. This is the vendor's API, not their consumer chat
# product; those are not covered by a BAA.
ANTHROPIC_API_KEY=
# Defaults to the cheapest tier. Override to move up: claude-sonnet-5, claude-opus-5.
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=
# Point at Azure OpenAI or a compatible gateway. Defaults to the OpenAI API.
OPENAI_BASE_URL=
# Strips the resident's name and every identifier before the request, then puts
# the real name back locally. Leave this ON: it means the hosted model receives
# no PHI at all, which removes the model vendor from your BAA scope entirely.
# Ignored by the local provider, where nothing leaves the machine anyway.
AI_DEIDENTIFY=true

# ---------------------------------------------------------------------------
# Database
#
# Supabase. For a fully local, free install run `supabase start` and paste the
# values it prints; for a hosted project use a HIPAA-eligible plan with a BAA.
# Either way, do NOT point this at the marketing site's project.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Column-encryption key for residents.medicaid_id_enc.
# Generate with: openssl rand -base64 32
PHI_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Drives "today" on the roster and the default service date.
NEXT_PUBLIC_ORG_TIMEZONE=America/New_York
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- billing (Stripe) ---
# Gates the AI draft button and nothing else. With these unset the app runs
# fine; the billing page says billing is not configured and the free allowance
# applies. Values come from your Stripe dashboard — never commit them.
STRIPE_SECRET_KEY=
# The recurring price customers subscribe to. Change the plan by creating a new
# price in Stripe and swapping this id; nothing in the code hardcodes an amount.
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret in production.
# Without it the webhook refuses every request, and no subscription ever
# activates — Stripe's signature is what authenticates that endpoint.
STRIPE_WEBHOOK_SECRET=
